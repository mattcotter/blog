---
import NavLayout from '../layouts/NavLayout.astro';
import Ledger from '../components/Ledger.astro';
import { loadPosts, formatFullDate, tagHref, tagCounts } from '../utils/posts.js';
import { site } from '../data/site.js';

const posts = loadPosts(import.meta.glob('./blog/*.md', { eager: true }));
const [featured, ...rest] = posts;
const topics = tagCounts(posts).slice(0, 8);

// A short, honest strip of work. The full case studies live on /portfolio.
const selectedWork = [
  { name: 'Connor Group', stack: 'WordPress multisite · Yardi API', href: 'https://connorgroup.com' },
  { name: 'Thrive IV USA', stack: 'WordPress · Zenoti API', href: 'https://thriveivusa.com/' },
  { name: 'Amy Denae Weight Loss', stack: 'WordPress · ACF · Gravity Forms', href: 'https://amydenaeweightloss.com' },
  { name: 'EPIC Art', stack: 'Design · WordPress · Elementor', href: 'https://epicartinspires.com/' },
];
---

<NavLayout pageTitle={`${site.name} — writing about the web`} description={site.description}>
  <section class="hero">
    <p class="hero__name">Matt Cotter · Front-end developer · {site.location}</p>

    <h1 class="hero__lede">
      Thirteen years of building for the web.{' '}
      <em>I write about the war stories, the tooling, and what the internet forgets.</em>
    </h1>

    <p class="status">
      <span class="status__dot" aria-hidden="true"></span>
      Freelancing · available for work
    </p>

    <div class="hero__meta">
      <a href={`mailto:${site.email}`}>Start a project →</a>
      <a href="/portfolio/">See the work →</a>
      <a href="/about/">More about me →</a>
    </div>
  </section>

  {featured && (
    <section class="band">
      <article class="feature">
        <div class="feature__kicker">
          <span class="mono">Latest · {formatFullDate(featured.pubDate)} · {featured.readingTime} min read</span>
          {featured.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
        </div>

        <h3 class="feature__title">
          <a href={featured.url}>{featured.title}</a>
        </h3>

        <p class="feature__excerpt">{featured.excerpt}</p>

        <div class="feature__foot">
          <span class="feature__cta">Read the essay →</span>
        </div>
      </article>
    </section>
  )}

  {rest.length > 0 && (
    <section class="band">
      <div class="band-head">
        <h2>Archive</h2>
        <a href="/blog/" class="mono">All {posts.length} essays →</a>
      </div>

      <Ledger posts={rest} />
    </section>
  )}

  {topics.length > 0 && (
    <section class="band">
      <div class="band-head">
        <h2>Topics</h2>
      </div>
      <div class="tag-row">
        {topics.map(({ tag, count }) => (
          <a href={tagHref(tag)} class="tag">
            {tag}<span class="tag__count">{count}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="band">
    <div class="band-head">
      <h2>Selected work</h2>
      <a href="/portfolio/" class="mono">All projects →</a>
    </div>

    <div class="work-list">
      {selectedWork.map((project) => (
        <a class="work-row" href={project.href} target="_blank" rel="noopener noreferrer">
          <span class="work-row__name">{project.name}</span>
          <span class="work-row__stack">{project.stack}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="band">
    <blockquote class="quote">
      I've worked with Matt for nearly two years building my website. He's honest,
      communicative, and knows how to bring a vision to life.
      <footer>Amy Sanford Hammond, Amy Denae Weight Loss</footer>
    </blockquote>
  </section>
</NavLayout>