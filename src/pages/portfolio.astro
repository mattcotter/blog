---
import NavLayout from '../layouts/NavLayout.astro';
import { Image } from 'astro:assets';
import amy from '../assets/amy-screenshot.jpg';
import tcg from '../assets/connorgroup-screenshot.jpg';
import epic from '../assets/epic-screenshot.jpg';
import thrive from '../assets/thriveivusa-screenshot.jpg';

import geaerospace from '../assets/logos/geaerospace.png';
import mcdonalds from '../assets/logos/mcdonalds.png';
import popeyes from '../assets/logos/popeyes.png';
import timhortons from '../assets/logos/timhortons.png';
import tcglogo from '../assets/logos/tcglogo.png';
import ymca from '../assets/logos/ymca.png';
import memi from '../assets/logos/memi.png';
import lionlogo from '../assets/logos/lionlogo.png';
import omj from '../assets/logos/omj.png';
import karlmalone from '../assets/logos/karlmalone.png';

import { site } from '../data/site.js';

const projects = [
  {
    title: 'Connor Group',
    description:
      'Manage and build features for an existing multi-million dollar WordPress multisite, including Yardi CRM integrations.',
    tags: ['WordPress', 'Multisite', 'Custom plugins', 'Divi', 'Yardi API'],
    image: tcg,
    href: 'https://connorgroup.com',
  },
  {
    title: 'Thrive IV USA',
    description:
      'Built a full site with deep Zenoti API integration for booking and scheduling, as part of my work with Reborn Consultants.',
    tags: ['WordPress', 'Zenoti API', 'Elementor', 'Gravity Forms'],
    image: thrive,
    href: 'https://thriveivusa.com/',
  },
  {
    title: 'Amy Denae Weight Loss',
    description:
      'Two years of ongoing development: maintaining the site and building the social features her members asked for.',
    tags: ['WordPress', 'ACF', 'PHP', 'Gravity Forms', 'Ads'],
    image: amy,
    href: 'https://amydenaeweightloss.com',
  },
  {
    title: 'EPIC Art',
    description:
      'Designed and built a custom site, and now handle their ongoing maintenance and digital presence.',
    tags: ['Design', 'WordPress', 'Elementor', 'Gravity Forms'],
    image: epic,
    href: 'https://epicartinspires.com/',
  },
];

// Names only — no logos. Using someone's mark to imply endorsement is a
// trademark problem; naming who you worked for is just a fact.
// TODO: confirm the `via` line on the last five. Best guess from the résumé.
const brands = [
  { name: 'GE Aerospace', via: 'Lead Front End Developer, in-house', logo: geaerospace },
  { name: "McDonald's", via: 'via Stratacache', logo: mcdonalds },
  { name: 'Popeyes', via: 'via Stratacache', logo: popeyes },
  { name: 'Tim Hortons', via: 'via Stratacache', logo: timhortons },
  { name: 'Connor Group', via: 'Web Developer, in-house', logo: tcglogo },
  { name: 'The YMCA', via: 'via TDH Marketing / Think Patented', logo: ymca },
  { name: 'MEMI', via: 'via TDH Marketing / Think Patented', logo: memi },
  { name: 'LION', via: 'via Contract', logo: lionlogo },
  { name: 'Ohio Means Jobs', via: 'via TDH Marketing / Think Patented', logo: omj },
  { name: 'Karl Malone Polaris', via: 'via Reborn Consultants', logo: karlmalone },
];

const description =
  'Recent client and agency work by Matt Cotter: WordPress builds, API integrations, and custom front-end development for brands including GE Aerospace, McDonald\u2019s, and the YMCA.';
---

<NavLayout pageTitle={`Work — ${site.name}`} description={description}>
  <section class="hero">
    <p class="hero__name">Work</p>

    <h1 class="hero__lede">
      A few projects I can show.{' '}
      <em>Most of the last decade was behind a login.</em>
    </h1>

    <div class="hero__meta">
      <a href={site.resume} download>Download résumé (PDF)</a>
      <a href={`mailto:${site.email}`}>Start a project →</a>
    </div>
  </section>

  <section class="band">
    <div class="band-head">
      <h2>Brands I've worked with</h2>
      <span class="mono">{brands.length} selected over 13 years</span>
    </div>

    <p class="brands__intro">
      Over the years, I've worked multi-million dollar brands. Some national, and a lot more locally.
    </p>

    <ul class="brands">
      {brands.map((brand) => (
        <li class="brand">
          <div class="brand__plate">
            {/* alt="" because the name sits right below — a screen reader
                announcing both would just read the brand twice. */}
            <Image src={brand.logo} alt="" height={50} loading="lazy" decoding="async" />
          </div>
          <span class="brand__name">{brand.name}</span>
          <span class="brand__via">{brand.via}</span>
        </li>
      ))}
    </ul>

  </section>

  <section class="band">
    <div class="band-head">
      <h2>Selected projects</h2>
      <span class="mono">{projects.length} of many</span>
    </div>

    <div class="project-grid">
      {projects.map((project) => (
        <a class="project" href={project.href} target="_blank" rel="noopener noreferrer">
          <Image src={project.image} alt={`Screenshot of the ${project.title} website`} />
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <div class="tag-row">
            {project.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="band">
    <div class="band-head">
      <h2>Also worth knowing</h2>
    </div>

    <div class="prose">
      <p>
        A lot of that work never gets a public URL, such as: 
        <ul>
          <li>Digital menu boards running in thousands of restaurant locations like <strong>McDonalds</strong></li>
          <li>An internal design system used by hundreds of engineers at <strong>GE Aerospace</strong></li>
          <li>Applications built under a Top Secret clearance for the <strong> Department of Defense</strong> at Wright-Patterson Air Force Base.</li>
        </ul>
      </p>
    </div>
  </section>
</NavLayout>