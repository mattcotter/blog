---
import NavLayout from '../layouts/NavLayout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/matt-cotter-logo.png';
import { site } from '../data/site.js';

const jobs = [
  { company: 'Self-employed', role: 'Freelance Web Developer', dates: 'Nov 2023 – Present', stack: 'WordPress, Shopify, PHP', current: true },
  { company: 'Connor Group', role: 'Lead Web Developer', dates: 'Sep 2025 – Jul 2026', stack: 'WordPress, Divi, ACF, WP-CLI, Yardi CRM' },
  { company: 'Reborn Consultants', role: 'Lead Web Developer', dates: 'Jul 2024 – Sep 2025', stack: 'WordPress, Elementor, Beaver Builder, ACF, Figma' },
  { company: 'Stratacache', role: 'Application Developer', dates: 'Oct 2021 – Jan 2024', stack: 'Vue, TypeScript' },
  { company: 'NASIC, Department of Defense', role: 'IT Specialist, Wright-Patterson AFB', dates: 'Sep 2020 – Oct 2021', stack: 'Vue, Django, Nuxt, Agile, TS Clearance' },
  { company: 'GE Aerospace', role: 'Lead Front End Developer', dates: 'Oct 2018 – Apr 2020', stack: 'Vue, JavaScript, CI/CD, APIs, Agile' },
  { company: 'RCF Information Systems', role: 'Web Developer', dates: 'Jun 2018 – Oct 2018', stack: 'Agile, contract work at Wright-Patterson AFB' },
  { company: 'Think Patented', role: 'Full Stack Developer', dates: 'Jan 2017 – Jun 2018', stack: 'Rebrand of TDH Marketing as Bitstorm Connect' },
  { company: 'TDH Marketing', role: 'Web Developer', dates: 'Dec 2013 – Jan 2017', stack: 'Joomla, Drupal, WordPress, SEO' },
];

const description =
  'Matt Cotter is a front-end developer in Cincinnati with 13+ years of experience across the Department of Defense, GE Aerospace, agencies, and small business clients.';
---

<NavLayout pageTitle={`About — ${site.name}`} description={description}>
  <section class="about-head">
    <div class="about-head__mark">
      <Image src={logo} alt="Illustrated portrait of Matt Cotter" width={224} height={224} />
    </div>

    <div>
      <h1 class="hero__lede" style="margin-bottom:1.25rem">
        Hey, I'm Matt. I've been building websites since <em>before CSS could do layout.</em>
      </h1>

      <div class="prose">
        <p>
          I'm a front-end developer with more than 13 years of experience, based in
          Cincinnati, Ohio. I've worked with companies large and small, building
          user-focused solutions across a lot of very different industries, from
          internal tooling for the Department of Defense to marketing sites for
          one-person businesses.
        </p>
        <p>
          I helped build <strong>McDonald's digital menu boards</strong> and led front-end
          work on <strong>GE Aerospace's</strong> internal design system, used by hundreds
          of engineers worldwide. Whatever the size of the project, the job is the same:
          dependable work that bridges design and development.
        </p>
        <p>
          I also <a href="/blog/">write about all of it</a>: the tooling, the WordPress
          war stories, and the parts of this industry nobody warns you about.
        </p>
      </div>

      <p style="margin-top:1.5rem">
        <a href={site.resume} download class="btn">Download résumé (PDF)</a>
      </p>
    </div>
  </section>

  <section class="band">
    <div class="band-head">
      <h2>Experience</h2>
      <span class="mono">{jobs.length} roles since 2014</span>
    </div>

    <div class="roles">
      {jobs.map((job) => (
        <div class={`role${job.current ? ' role--current' : ''}`}>
          <div class="role__dates">{job.dates}</div>
          <div>
            <div class="role__company">{job.company}</div>
            <div class="role__role">{job.role}</div>
            <div class="role__stack">{job.stack}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="band">
    <div class="band-head">
      <h2>Work with me</h2>
    </div>

    <div class="prose">
      <p>
        If you need an experienced WordPress or front-end developer who can take a
        project from design through deployment, I'd like to help. Over 13+ years I've
        built custom WordPress themes, Shopify stores, design systems, internal
        applications, and marketing sites for startups, agencies, Fortune 500 companies,
        and government organisations.
      </p>
      <p>
        I specialise in modern front-end development, technical SEO, performance,
        accessibility, and building sites that clients can actually maintain themselves.
        Ongoing support, a full rebuild, custom functionality, or a speed and search
        cleanup. All fair game.
      </p>
    </div>

    <p style="margin-top:1.75rem">
      <a href={`mailto:${site.email}`} class="btn btn--solid">Email me →</a>
    </p>
  </section>
</NavLayout>