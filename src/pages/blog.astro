---
import NavLayout from '../layouts/NavLayout.astro';
import { loadPosts, groupByYear, formatDate, tagHref, tagCounts } from '../utils/posts.js';
import { site } from '../data/site.js';

const posts = loadPosts(import.meta.glob('./blog/*.md', { eager: true }));
const groups = groupByYear(posts);
const topics = tagCounts(posts);
const totalWords = posts.reduce((sum, post) => sum + post.wordCount, 0);
const description =
  'Essays on web development, WordPress, and the history of the internet by Matt Cotter.';
---

<NavLayout pageTitle={`Writing — ${site.name}`} description={description}>
  <section class="hero">
    <p class="hero__name">Writing</p>

    <h1 class="hero__lede">
      Essays about building for the web — and <em>what it costs</em>.
    </h1>

    <div class="hero__meta">
      <span class="mono">
        {posts.length} essays · {totalWords.toLocaleString('en-US')} words · since {groups[groups.length - 1]?.year}
      </span>
      <a href="/rss.xml">Subscribe by RSS →</a>
    </div>
  </section>

  <section class="band--tight">
    <div class="tag-row" id="filters">
      <button type="button" class="tag tag--on" data-filter="all">all</button>
      {topics.map(({ tag, count }) => (
        <button type="button" class="tag" data-filter={tag}>
          {tag}<span class="tag__count">{count}</span>
        </button>
      ))}
    </div>
  </section>

  <section class="band--tight">
    <div class="ledger" id="archive">
      {groups.map((group) => (
        <div class="year-block" data-tags={group.posts.flatMap((p) => p.tags).join('|')}>
          <div class="ledger__year">
            <b>{group.year}</b>
            <i>{group.posts.length} {group.posts.length === 1 ? 'essay' : 'essays'}</i>
          </div>

          {group.posts.map((post) => (
            <article class="entry" data-tags={post.tags.join('|')}>
              <div class="entry__date">{formatDate(post.pubDate)}</div>

              <div>
                <h2 class="entry__title"><a href={post.url}>{post.title}</a></h2>
                {post.description && <p class="entry__desc">{post.description}</p>}
                <div class="entry__foot">
                  <span class="mono">{post.readingTime} min read</span>
                  {post.tags.map((tag) => (
                    <a href={tagHref(tag)} class="tag">{tag}</a>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      ))}
    </div>

    <p class="ledger-note" id="empty" hidden>Nothing filed under that topic yet.</p>
    <p class="ledger-note">Titles turn <b>purple</b> once you've read them.</p>
  </section>
</NavLayout>

<script is:inline>
  (function () {
    var filters = document.getElementById('filters');
    var empty = document.getElementById('empty');
    if (!filters) return;

    filters.addEventListener('click', function (event) {
      var button = event.target.closest('[data-filter]');
      if (!button) return;

      var active = button.dataset.filter;

      filters.querySelectorAll('[data-filter]').forEach(function (el) {
        el.classList.toggle('tag--on', el === button);
      });

      var shown = 0;
      document.querySelectorAll('#archive .entry').forEach(function (entry) {
        var tags = (entry.dataset.tags || '').split('|');
        var match = active === 'all' || tags.indexOf(active) !== -1;
        entry.hidden = !match;
        if (match) shown++;
      });

      // Hide a year heading when nothing under it survived the filter.
      document.querySelectorAll('#archive .year-block').forEach(function (block) {
        var visible = block.querySelectorAll('.entry:not([hidden])').length;
        block.hidden = visible === 0;
      });

      empty.hidden = shown !== 0;
    });
  })();
</script>
