---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/matt-cotter-logo.png';
import { site, navLinks, socialLinks } from '../data/site.js';

const {
  pageTitle,
  description = site.description,
  ogType = 'website',
  progress = false,
  article = null,
  image = site.ogImage,
  imageAlt = `${site.name} — ${site.jobTitle}`,
  breadcrumbs = null, // [{ name, href }] — omit the current page, it's appended for you
  profile = false, // true on /about so the page is typed as a ProfilePage
  noindex = false,
} = Astro.props;

// GitHub Pages serves directory indexes, so /about/ is the real URL. Normalising
// here stops /about and /about/ from splitting signals between two canonicals.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path === '/' ? '/' : `${path}/`, site.url).toString();

const ogImage = new URL(image, site.url).toString();
const headshot = new URL(site.headshot, site.url).toString();

const isCurrent = (href) => {
  const target = href.replace(/\/+$/, '') || '/';
  return target === '/' ? path === '/' : path === target || path.startsWith(`${target}/`);
};

const toISO = (value) => {
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? undefined : date.toISOString();
};

const publishedISO = article ? toISO(article.pubDate) : undefined;
const modifiedISO = article ? toISO(article.updatedDate ?? article.pubDate) : undefined;

/* ---------- Structured data -------------------------------------------------
   One @graph per page with stable @id values, so every node points at the same
   Person instead of redeclaring a new one. sameAs is what consolidates the
   GitHub / LinkedIn / Bluesky profiles into a single entity named Matt Cotter.
--------------------------------------------------------------------------- */
const personId = `${site.url}/#person`;
const siteId = `${site.url}/#website`;

const person = {
  '@type': 'Person',
  '@id': personId,
  name: site.name,
  url: `${site.url}/`,
  image: headshot,
  jobTitle: site.jobTitle,
  email: `mailto:${site.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Cincinnati',
    addressRegion: 'OH',
    addressCountry: 'US',
  },
  knowsAbout: site.knowsAbout,
  sameAs: site.sameAs,
};

const website = {
  '@type': 'WebSite',
  '@id': siteId,
  url: `${site.url}/`,
  name: site.name,
  description: site.description,
  inLanguage: 'en-US',
  publisher: { '@id': personId },
};

const pageNode = article
  ? {
      '@type': 'BlogPosting',
      '@id': `${canonical}#article`,
      url: canonical,
      headline: String(article.title).slice(0, 110),
      description,
      datePublished: publishedISO,
      dateModified: modifiedISO,
      image: ogImage,
      keywords: article.tags?.join(', '),
      inLanguage: 'en-US',
      author: { '@id': personId },
      publisher: { '@id': personId },
      isPartOf: { '@id': siteId },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    }
  : {
      '@type': profile ? 'ProfilePage' : 'WebPage',
      '@id': canonical,
      url: canonical,
      name: pageTitle,
      description,
      inLanguage: 'en-US',
      isPartOf: { '@id': siteId },
      ...(profile ? { mainEntity: { '@id': personId } } : { about: { '@id': personId } }),
    };

const crumbList = breadcrumbs && {
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumbs`,
  itemListElement: [...breadcrumbs, { name: pageTitle, href: canonical }].map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.name,
    item: new URL(crumb.href, site.url).toString(),
  })),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [person, website, pageNode, ...(crumbList ? [crumbList] : [])],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />

    {/* max-image-preview:large is what lets your headshot show as a large thumbnail. */}
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />

    {/* rel="me" is a machine-readable ownership claim, and it's what Bluesky and
        Mastodon use to verify the link back to this domain. */}
    {site.sameAs.map((href) => <link rel="me" href={href} />)}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    {article && publishedISO && <meta property="article:published_time" content={publishedISO} />}
    {article && modifiedISO && <meta property="article:modified_time" content={modifiedISO} />}
    {article && <meta property="article:author" content={site.name} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — Writing`}
      href="/rss.xml"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400..700&family=JetBrains+Mono:wght@400..600&family=Literata:ital,opsz,wght@0,7..72,300..700;1,7..72,300..700&display=swap"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VB1TSGDEV4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-VB1TSGDEV4');

      // Set the theme before first paint so there's no flash.
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>

  <body data-progress={progress ? 'on' : 'off'}>
    <a href="#main" class="skip-link">Skip to content</a>

    <div class="top-bar" aria-hidden="true">
      <div class="top-bar__fill"></div>
    </div>

    <div class="dock-rail">
      <nav class="dock" aria-label="Primary">
        <a href="/" class="dock__logo" aria-label={`${site.name} — home`}>
          <Image src={logo} alt="" width={96} height={96} loading="eager" />
        </a>

        <div class="dock__links">
          {navLinks.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.name}
            </a>
          ))}
        </div>

        <span class="dock__divider" aria-hidden="true"></span>

        <div class="dock__social">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              aria-label={link.name}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noopener noreferrer me' : undefined}
            >
              <span set:html={link.svg}></span>
            </a>
          ))}
        </div>
      </nav>

      <button id="theme-toggle" class="theme-toggle" aria-label="Switch to light theme">
      <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1.5m0 15V21m8.485-8.485h-1.5m-13.97 0h-1.5m14.849-6.364-1.06 1.06M6.196 17.804l-1.06 1.06m12.728 0-1.06-1.06M6.196 6.196l-1.06-1.06M16.5 12a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z" />
      </svg>
      <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
      </svg>
      </button>
    </div>

    <main id="main" class="page">
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <div class="site-footer__social">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              aria-label={link.name}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noopener noreferrer me' : undefined}
            >
              <span set:html={link.svg}></span>
            </a>
          ))}
        </div>
        <a href={`mailto:${site.email}`} class="mono">{site.email}</a>
        <span class="mono">© {new Date().getFullYear()} {site.name} · {site.location} · Art by Olivia Cotter</span>
      </div>

      <a href="#" id="game-trigger" class="mono">🕹️ Let's play a game</a>
    </footer>

    <div id="game-overlay" class="game-overlay" hidden role="dialog" aria-modal="true" aria-labelledby="game-title">
      <div class="game-box">
        <button id="game-close" class="game-close" aria-label="Close">&times;</button>
        <h3 id="game-title">Let's play a game</h3>
        <p id="game-message">Guess a number between 1 and 5.</p>
        <div class="game-row">
          <label class="visually-hidden" for="game-guess">Your guess</label>
          <input id="game-guess" type="number" min="1" max="5" inputmode="numeric" />
          <button id="game-submit" class="btn btn--solid">Guess</button>
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        // ---- Theme -------------------------------------------------------
        var root = document.documentElement;
        var toggle = document.getElementById('theme-toggle');

        function syncToggleLabel() {
          var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
          toggle.setAttribute('aria-label', 'Switch to ' + next + ' theme');
        }
        syncToggleLabel();

        toggle.addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
          root.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
          syncToggleLabel();
        });

        // ---- Reading progress (essays only) ------------------------------
        if (document.body.dataset.progress === 'on') {
          var bar = document.querySelector('.top-bar__fill');
          var ticking = false;

          var update = function () {
            var max = document.documentElement.scrollHeight - window.innerHeight;
            var ratio = max > 0 ? Math.min(1, window.scrollY / max) : 1;
            bar.style.setProperty('--read', ratio.toFixed(4));
            ticking = false;
          };

          update();
          window.addEventListener('scroll', function () {
            if (!ticking) { ticking = true; requestAnimationFrame(update); }
          }, { passive: true });
          window.addEventListener('resize', update);
        }

        // ---- Number guessing easter egg ----------------------------------
        var trigger = document.getElementById('game-trigger');
        var overlay = document.getElementById('game-overlay');
        var closeBtn = document.getElementById('game-close');
        var submit = document.getElementById('game-submit');
        var input = document.getElementById('game-guess');
        var message = document.getElementById('game-message');
        var target = 0;

        function openGame(e) {
          e.preventDefault();
          target = Math.floor(Math.random() * 5) + 1;
          message.textContent = 'Guess a number between 1 and 5.';
          input.value = '';
          overlay.hidden = false;
          input.focus();
        }

        function closeGame() { overlay.hidden = true; trigger.focus(); }

        function guess() {
          var value = parseInt(input.value, 10);
          if (!value || value < 1 || value > 5) {
            message.textContent = 'Pick a number between 1 and 5.';
            return;
          }
          if (value === target) {
            root.classList.remove('comic-sans-mode');
            message.textContent = 'Got it. Everything goes back to normal.';
            setTimeout(closeGame, 1100);
          } else {
            root.classList.add('comic-sans-mode');
            message.textContent = 'Wrong. The whole site is Comic Sans now. Guess again to undo it.';
          }
        }

        trigger.addEventListener('click', openGame);
        closeBtn.addEventListener('click', closeGame);
        overlay.addEventListener('click', function (e) { if (e.target === overlay) closeGame(); });
        submit.addEventListener('click', guess);
        input.addEventListener('keydown', function (e) { if (e.key === 'Enter') guess(); });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !overlay.hidden) closeGame();
        });
      })();
    </script>
  </body>
</html>