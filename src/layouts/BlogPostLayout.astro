---
import NavLayout from './NavLayout.astro';
import { loadPosts, readingTime, formatFullDate, tagHref } from '../utils/posts.js';
import { site } from '../data/site.js';

const { frontmatter, rawContent } = Astro.props;

const body = typeof rawContent === 'function' ? rawContent() : '';
const minutes = readingTime(body);

const posts = loadPosts(import.meta.glob('../pages/blog/*.md', { eager: true }));
const here = Astro.url.pathname.replace(/\/+$/, '');
const index = posts.findIndex((post) => post.url.replace(/\/+$/, '') === here);

// posts are newest-first, so the *next* essay to read is the older one
const newer = index > 0 ? posts[index - 1] : null;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : null;

const description = frontmatter.description || site.description;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const shareUrl = encodeURIComponent(canonical);
const shareTitle = encodeURIComponent(frontmatter.title);

const shareLinks = [
  { name: 'Bluesky', href: `https://bsky.app/intent/compose?text=${shareTitle}%20${shareUrl}` },
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}` },
  { name: 'X', href: `https://twitter.com/intent/tweet?text=${shareTitle}&url=${shareUrl}` },
  { name: 'Email', href: `mailto:?subject=${shareTitle}&body=${shareUrl}` },
];
---

<NavLayout
  pageTitle={`${frontmatter.title} — ${site.name}`}
  description={description}
  ogType="article"
  progress={true}
  article={frontmatter}
>
  <article>
    <header class="essay-head">
      <p class="mono" style="margin-bottom:1rem">
        <a href="/blog/">Writing</a> / {new Date(frontmatter.pubDate).getUTCFullYear()}
      </p>

      <h1>{frontmatter.title}</h1>

      {frontmatter.description && (
        <p class="essay-head__desc">{frontmatter.description}</p>
      )}

      <div class="essay-head__meta">
        <span class="mono">
          {frontmatter.author} · <time datetime={frontmatter.pubDate}>{formatFullDate(frontmatter.pubDate)}</time> · {minutes} min read
        </span>
      </div>
    </header>

    <div class="essay">
      <slot />
    </div>

    <footer class="essay-foot">
      {frontmatter.tags?.length > 0 && (
        <div class="tag-row">
          {frontmatter.tags.map((tag) => (
            <a href={tagHref(tag)} class="tag">{tag}</a>
          ))}
        </div>
      )}

      <div class="share-row">
        <span class="mono">Share</span>
        {shareLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer">{link.name}</a>
        ))}
      </div>

      {(newer || older) && (
        <nav class="pager" aria-label="More essays">
          {older ? (
            <a class="pager__item" href={older.url}>
              <span class="pager__label">← Older</span>
              <span class="pager__title">{older.title}</span>
            </a>
          ) : <span></span>}

          {newer ? (
            <a class="pager__item pager__item--next" href={newer.url}>
              <span class="pager__label">Newer →</span>
              <span class="pager__title">{newer.title}</span>
            </a>
          ) : <span></span>}
        </nav>
      )}
    </footer>
  </article>
</NavLayout>
